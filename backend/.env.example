# Backend Configuration
PROJECT_NAME="CodePilot AI API"
VERSION="0.1.0"
API_V1_PREFIX="/api"

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=codepilot

# Optional: Direct database connection URL (overrides individual POSTGRES_* settings if set)
# Examples:
# PostgreSQL: postgresql://postgres:your_secure_password_here@localhost:5432/codepilot
# SQLite (Local test/dev fallback): sqlite:///./codepilot_dev.db
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/codepilot

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Groq AI Service Configuration (Phase 2)
# Obtain your API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
# Configurable Groq chat model: e.g. llama-3.3-70b-versatile, llama-3.1-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30.0

# GitHub Repository Intelligence & FAISS Vector Search (Phase 6)
# Configurable embedding model via fastembed (e.g. BAAI/bge-small-en-v1.5, BAAI/bge-base-en-v1.5)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
# Local storage directories (isolated, git-ignored)
IMPORTED_REPOS_DIR=imported_repositories
FAISS_INDEXES_DIR=faiss_indexes
# Repository limits and guardrails
MAX_REPO_FILE_SIZE_BYTES=524288
MAX_REPO_TOTAL_SIZE_BYTES=26214400
MAX_REPO_FILE_COUNT=1000
REPO_IMPORT_TIMEOUT_SECONDS=60.0
# Phase 8: Isolated Code Execution Sandbox
DOCKER_PYTHON_IMAGE=python:3.12-slim
DOCKER_NODE_IMAGE=node:20-alpine
SANDBOX_TIMEOUT_SECONDS=30.0
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_MAX_CPUS=1.0
SANDBOX_MAX_PIDS=64
SANDBOX_MAX_CONCURRENT_JOBS=3
SANDBOX_HOURLY_QUOTA_PER_PROJECT=20
SANDBOX_ENABLE_MOCK_FALLBACK=True

# Phase 9: Production Readiness, Security & Deployment
API_AUTH_ENABLED=False
API_AUTH_KEY=cp_secret_token_change_in_production
REQUEST_TIMEOUT_SECONDS=60.0
MAX_PAYLOAD_SIZE_BYTES=10485760
LOG_LEVEL=INFO
